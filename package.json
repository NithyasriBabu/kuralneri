{
  "name": "kuralneri",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prestart": "node check-node.cjs",
    "start": "expo start",
    "preandroid": "node check-node.cjs",
    "android": "expo start --android",
    "preios": "node check-node.cjs",
    "ios": "expo start --ios",
    "preweb": "node check-node.cjs",
    "web": "expo start --web",
    "lint": "eslint App.tsx index.ts app.config.ts src --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "prepare": "husky",
    "reset": "rm -rf node_modules && yarn install && npx husky init",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo-google-fonts/arima-madurai": "^0.2.3",
    "@expo-google-fonts/catamaran": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/merriweather": "^0.4.2",
    "@expo-google-fonts/mukta-malar": "^0.4.1",
    "@expo-google-fonts/source-serif-pro": "^0.2.3",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "i18next": "^26.3.1",
    "lucide-react-native": "^1.14.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-universe": "^15.0.4",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "react-test-renderer": "19.1.0",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.cjs"],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  }
}
